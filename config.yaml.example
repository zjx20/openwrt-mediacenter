# OpenWrt 媒体中心配置文件
# 复制此文件为 config.yaml 并根据实际情况修改

server:
  host: "0.0.0.0"
  port: 8080

# 音频设备配置
audio:
  # 音频后端: pulse (推荐，自动路由到蓝牙音箱等) / alsa
  backend: "pulse"
  # PulseAudio sink 名称，留空则使用系统默认 sink（通常就是蓝牙音箱）
  # 使用 `pactl list short sinks` 查看可用 sink
  pulse_sink: ""
  # 背景音乐的默认音量 (0-100)
  default_volume: 50

# 背景音乐配置
background_music:
  # 是否开机自动播放
  auto_play: false
  # 默认播放列表 (URL 列表)
  playlist: []
  # 播放模式: sequential / shuffle / repeat_one / repeat_all
  play_mode: "repeat_all"

# AirPlay 配置 (shairport-sync)
airplay:
  enabled: true
  # 显示的设备名称
  name: "OpenWrt MediaCenter"
  # AirPlay 首次开始播放时的默认输出音量 (0-100)
  # 仅作为本地初始基准，后续仍可由手机端调音量覆盖
  default_volume: 80
  # shairport-sync 配置文件路径；留空时使用内置启动参数
  # Docker 自定义配置推荐挂载到: /etc/mediacenter/shairport-sync.conf
  # 主机直装如需自定义配置，可填写: /etc/shairport-sync.conf
  config_path: ""
  # 端口
  port: 5000

# DLNA 配置 (upmpdcli + MPD)
dlna:
  enabled: true
  # 显示的设备名称
  name: "OpenWrt MediaCenter"
  # DLNA / UPnP Renderer 的默认音量 (0-100)
  # 服务启动后、以及每次串流结束回到待机时，都会恢复到这个值
  default_volume: 40
  # 端口
  port: 49152

# TTS 配置
tts:
  # 引擎: edge-tts / openai / piper
  engine: "edge-tts"
  # edge-tts 语音（engine 为 edge-tts 时生效）
  # 可选中文音色:
  #   zh-HK-HiuMaanNeural   曉曼 粤语 女（默认）
  #   zh-HK-HiuGaaiNeural   曉佳 粤语 女
  #   zh-HK-WanLungNeural   雲龍 粤语 男
  #   zh-CN-XiaoxiaoNeural  晓晓 普通话 女
  #   zh-CN-YunxiNeural     云希 普通话 男
  #   zh-CN-YunyangNeural   云扬 普通话 男（播音腔）
  voice: "zh-HK-HiuMaanNeural"
  # 语速调整，范围 -50% ~ +50%（edge-tts 时生效）
  rate: "+0%"
  # 音调调整，单位 Hz，如 +10Hz / -5Hz（edge-tts 时生效）
  pitch: "+0Hz"
  # TTS 播报音量 (0-130)，超过 100 时 mpv 会做软件增益
  # edge-tts 生成的音频电平通常低于商业音乐，建议设为 70-100
  volume: 70
  # TTS 缓存目录
  cache_dir: "/tmp/tts_cache"
  # 缓存上限 (MB)，超出后按最久未访问顺序淘汰；0 表示不限制
  cache_max_mb: 50
  # OpenAI 兼容 TTS 配置（engine 为 openai 时生效）
  openai:
    api_key: ""
    base_url: "https://api.openai.com/v1"
    model: "tts-1"
    voice: "alloy"

# 定时任务
scheduler:
  jobs:
    # 示例：每天 08:00 播报早安问候
    # - id: "morning_greeting"
    #   name: "早安问候"
    #   enabled: false
    #   cron: "0 8 * * *"
    #   runtime: "python"
    #   script: |
    #     await tts.speak("早上好，今天也要元气满满！")

# AI 配置
ai:
  enabled: false
  # OpenAI 兼容 API
  api_key: ""
  base_url: "https://api.openai.com/v1"
  model: "gpt-4o"
  # 系统提示词
  system_prompt: "你是一个智能家居助手，可以控制音乐播放、TTS 播报等。"
  # 记忆文件路径
  memory_file: "/etc/mediacenter/memory.json"

#!/bin/sh
# OpenWrt 媒体中心 init.d 服务脚本
# 复制到 /etc/init.d/mediacenter

START=99
STOP=10
USE_PROCD=1

PROG="/usr/bin/python3"
ARGS="-m mediacenter -c /etc/mediacenter/config.yaml"
WORK_DIR="/opt/mediacenter"

start_service() {
    procd_open_instance
    procd_set_param command $PROG $ARGS
    procd_set_param respawn
    procd_set_param stderr 1
    procd_set_param stdout 1
    procd_set_param pidfile /var/run/mediacenter.pid
    procd_close_instance
}

stop_service() {
    killall -9 python3 2>/dev/null || true
}
